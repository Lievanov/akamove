# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# env files — never track real env values, only .env.example
.env
.env*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# expo — local dev-server/device state, not app code
.expo/

# Claude Code / Impeccable — personal, machine-specific settings.
# Shared skill/config content elsewhere under .claude/ and .impeccable/
# stays tracked; only these local-only files are excluded.
.claude/settings.local.json
.impeccable/*.local.json

# Test env (local Supabase; may later hold a Stripe test key)
.env.test

# Playwright
/.next-e2e/
/e2e/.auth/
/test-results/
/playwright-report/
