# Copy to .env and fill in real values. These NEXT_PUBLIC_* vars are
# embedded in the client bundle at build time — safe to expose in the
# browser, but still keep this file out of git so nobody has to think
# about whether a given value is actually safe to publish.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Server-only secret — goes in .env.local (already gitignored), not here.
# Required by app/api/account/delete and app/api/account/delete-request.
# SUPABASE_SERVICE_ROLE_KEY=

# Public URL of this app — used for Stripe Checkout / Portal return links.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Stripe (server-only — .env.local). Use a sandbox key while developing;
# a restricted key (rk_...) is preferred over the full secret key.
# Run `npm run stripe:setup` to create the products, prices and portal
# configuration, and to print STRIPE_PORTAL_CONFIGURATION_ID.
# STRIPE_SECRET_KEY=
# STRIPE_PORTAL_CONFIGURATION_ID=
# STRIPE_WEBHOOK_SECRET=        # Phase 3 — from `stripe listen` locally
# Bearer token for GET /api/billing/reconcile (nightly re-sync). Any long
# random string; your scheduler (e.g. Vercel Cron) sends it.
# CRON_SECRET=
