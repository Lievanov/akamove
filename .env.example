# Copy to .env and fill in real values. These NEXT_PUBLIC_* vars are
# embedded in the client bundle at build time — safe to expose in the
# browser, but still keep this file out of git so nobody has to think
# about whether a given value is actually safe to publish.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Server-only secret — goes in .env.local (already gitignored), not here.
# Required by app/api/account/delete and app/api/account/delete-request.
# SUPABASE_SERVICE_ROLE_KEY=
